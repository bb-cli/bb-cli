#!/usr/bin/env php
<?php

require_once __DIR__.'/../src/utils/helpers.php';
require_once __DIR__.'/../src/Base.php';

const APP_VERSION = '#APP_VERSION#';

if (version_compare(phpversion(), '7.0.0') < 0) {
    o('Your PHP version must be equal or higher than "7.0.0" to use bb-cli', 'red');
    o('PHP version: '.phpversion(), 'yellow');
    exit(1);
}

$requiredExtensions = [
    'json',
    'curl',
    'mbstring',
];

if ($missingExtensions = array_diff($requiredExtensions, get_loaded_extensions())) {
    o('PHP extensions is incomplete. Required installing:', 'red');
    o($missingExtensions, 'yellow');
    exit(1);
}

$actionsFolder = __DIR__.'/../src/Actions';
foreach (scandir($actionsFolder) as $file) {
    if (substr($file, -4) === '.php') {
        require_once "{$actionsFolder}/{$file}";
    }
}

$actions = [
    'pr' => \BBCli\BBCli\Actions\Pr::class,
    'pr-details' => \BBCli\BBCli\Actions\PrDetails::class,
    'pipeline' => \BBCli\BBCli\Actions\Pipeline::class,
    'branch' => \BBCli\BBCli\Actions\Branch::class,
    'auth' => \BBCli\BBCli\Actions\Auth::class,
    'browse' => \BBCli\BBCli\Actions\Browse::class,
    'upgrade' => \BBCli\BBCli\Actions\Upgrade::class,
    'env' => \BBCli\BBCli\Actions\Env::class,
];

$staticCommands = [
    'help' => [
        'help',
        '--help',
        '-h',
    ],
    'version' => [
        'version',
        '--version',
        '-v',
    ],
    'autocomplete' => [
        'autocomplete',
        '--autocomplete',
    ],
];

// Check for --project, --title, --description, --destination, --reviewers, --draft,
// --file, --line, --reply-to, --branch and --limit arguments and extract them
$projectUrl = null;
$prTitle = null;
$prDescription = null;
$prDestination = null;
$prReviewers = null;
$draft = false;
$commentFile = null;
$commentLine = null;
$commentReplyTo = null;
$pipelineBranch = null;
$pipelineLimit = null;
$interactive = false;
$filteredArgv = [];
for ($i = 0; $i < count($argv); $i++) {
    if ($argv[$i] === '--project' && isset($argv[$i + 1])) {
        $projectUrl = $argv[$i + 1];
        $i++; // Skip the next argument (the URL)
    } elseif ($argv[$i] === '--title' && isset($argv[$i + 1])) {
        $prTitle = $argv[$i + 1];
        $i++;
    } elseif ($argv[$i] === '--description' && isset($argv[$i + 1])) {
        $prDescription = $argv[$i + 1];
        $i++;
    } elseif ($argv[$i] === '--destination' && isset($argv[$i + 1])) {
        $prDestination = $argv[$i + 1];
        $i++;
    } elseif ($argv[$i] === '--reviewers' && isset($argv[$i + 1])) {
        $prReviewers = $argv[$i + 1];
        $i++;
    } elseif ($argv[$i] === '--draft') {
        $draft = true;
    } elseif ($argv[$i] === '--file' && isset($argv[$i + 1])) {
        $commentFile = $argv[$i + 1];
        $i++;
    } elseif ($argv[$i] === '--line' && isset($argv[$i + 1])) {
        $commentLine = $argv[$i + 1];
        $i++;
    } elseif ($argv[$i] === '--reply-to' && isset($argv[$i + 1])) {
        $commentReplyTo = $argv[$i + 1];
        $i++;
    } elseif ($argv[$i] === '--branch' && isset($argv[$i + 1])) {
        $pipelineBranch = $argv[$i + 1];
        $i++;
    } elseif ($argv[$i] === '--limit' && isset($argv[$i + 1])) {
        $pipelineLimit = $argv[$i + 1];
        $i++;
    } elseif ($argv[$i] === '-i' || $argv[$i] === '--interactive') {
        $interactive = true;
    } else {
        $filteredArgv[] = $argv[$i];
    }
}
$argv = $filteredArgv;

// Set global project URL for use in getRepoPath()
if ($projectUrl) {
    $GLOBALS['bb_cli_project_url'] = $projectUrl;
}

// Set global PR fields for use in Pr::create() and Pr::edit()
if ($prTitle) {
    $GLOBALS['bb_cli_pr_title'] = $prTitle;
}
if ($prDescription) {
    $GLOBALS['bb_cli_pr_description'] = $prDescription;
}
if ($prDestination) {
    $GLOBALS['bb_cli_pr_destination'] = $prDestination;
}
if ($prReviewers) {
    $GLOBALS['bb_cli_pr_reviewers'] = $prReviewers;
}
if ($draft) {
    $GLOBALS['bb_cli_pr_draft'] = true;
}
if ($interactive) {
    $GLOBALS['bb_cli_interactive'] = true;
}

// Set global pipeline filters for use in Pipeline::list() and Pipeline::recent()
if (!is_null($pipelineBranch)) {
    $GLOBALS['bb_cli_pipeline_branch'] = $pipelineBranch;
}
if (!is_null($pipelineLimit)) {
    $GLOBALS['bb_cli_pipeline_limit'] = $pipelineLimit;
}

// Set global comment placement for use in Pr::comment()
if (!is_null($commentFile)) {
    $GLOBALS['bb_cli_pr_comment_file'] = $commentFile;
}
if (!is_null($commentLine)) {
    $GLOBALS['bb_cli_pr_comment_line'] = $commentLine;
}
if (!is_null($commentReplyTo)) {
    $GLOBALS['bb_cli_pr_comment_reply_to'] = $commentReplyTo;
}

$userBaseAction = $argv[1] ?? null;

// Print version
if (in_array($userBaseAction, $staticCommands['version'])) {
    o('Version: '.APP_VERSION, 'green');
    exit(0);
}

// Print help
if (is_null($userBaseAction) || in_array($userBaseAction, $staticCommands['help'])) {
    o('Available actions:', 'green');
    foreach ($actions as $name => $className) {
        $description = defined("{$className}::ACTION_DESCRIPTION") ? $className::ACTION_DESCRIPTION : '';
        o(sprintf('  %-14s %s', $name, $description), 'yellow');
    }
    o('', 'white');
    o('Use "bb <action> --help" for subcommand details.', 'white');
    o('', 'white');
    o('Global options:', 'green');
    o('  --project <repo>         Work with repository (e.g., --project "owner/repo" or --project "https://bitbucket.org/owner/repo")', 'yellow');
    o('  -i, --interactive        Enable interactive mode (e.g., prompt for PR title and description)', 'yellow');
    o('  --title <title>          Set PR title (used with pr create, pr edit)', 'yellow');
    o('  --description <desc>     Set PR description (used with pr create, pr edit)', 'yellow');
    o('  --destination <branch>   Set PR destination branch (used with pr edit)', 'yellow');
    o('  --reviewers <names>      Set PR reviewers, comma-separated usernames or UUIDs (used with pr create, pr edit)', 'yellow');
    o('  --draft                  Create the PR as a draft (used with pr create; see "bb pr ready" to undraft)', 'yellow');
    o('  --file <path>            Comment inline on this file (used with pr comment, needs --line)', 'yellow');
    o('  --line <n>               Line in the new version of --file to comment on (used with pr comment)', 'yellow');
    o('  --reply-to <id>          Reply to a comment, IDs are shown by "bb pr show" (used with pr comment)', 'yellow');
    o('  --branch <name>          Branch to read bitbucket-pipelines.yml from, or to filter runs by (used with pipeline list, pipeline recent)', 'yellow');
    o('  --limit <n>              Number of runs to show, 1-100, default 20 (used with pipeline recent)', 'yellow');
    exit(0);
}

// Print autocomplete
if (in_array($userBaseAction, $staticCommands['autocomplete'])) {
    echo implode(' ', array_keys($actions));
    exit(0);
}

if (!isset($actions[$userBaseAction])) {
    o("Given action is invalid: ({$userBaseAction})", 'red');
    exit(1);
}

$actionClass = new $actions[$userBaseAction]();
$userAction = $argv[2] ?? null;

// Print help for action
if (in_array($userAction, $staticCommands['help'])) {
    $hasSubcommands = !empty($actionClass::AVAILABLE_COMMANDS);
    $header = $hasSubcommands ? "bb {$userBaseAction} <subcommand> [args]" : "bb {$userBaseAction}";
    o($header, 'green');
    o('', 'white');
    $commandDetails = defined(get_class($actionClass).'::COMMAND_DETAILS')
        ? $actionClass::COMMAND_DETAILS
        : [];
    foreach ($actionClass::AVAILABLE_COMMANDS as $method => $aliases) {
        $aliasDisplay = implode(', ', array_map('trim', explode(',', $aliases)));
        $args         = $commandDetails[$method]['args'] ?? '';
        $description  = $commandDetails[$method]['description'] ?? '';
        $usage        = $args ? "{$aliasDisplay} {$args}" : $aliasDisplay;
        o(sprintf('  %-42s %s', $usage, $description), 'yellow');
    }
    exit(0);
}

//Print autocomplete for action
if (in_array($userAction, $staticCommands['autocomplete'])) {
    $actionClass->listCommandsForAutocomplete();
    exit(0);
}

// Check if git folder exists (skip if --project is used)
if ($actionClass::CHECK_GIT_FOLDER && !$projectUrl) {
    $gitDir = trim((string) exec('git rev-parse --git-dir 2>/dev/null'));
    if ($gitDir === '') {
        o('ERROR: No git repository found in current directory.', 'red');
        o('Use --project "owner/repo" to work with remote repository.', 'yellow');
        exit(1);
    }
}

$classMethodToCall = $actionClass::DEFAULT_METHOD;

if (!is_null($userAction)) {
    $classMethodToCall = $actionClass->getMethodNameFromAlias($userAction);
}

if ($classMethodToCall === false) {
    o("Unknown method ", 'red', '', "\033[0m");
    o("{$argv[2]}", 'cyan', '', "\033[0m");
    o(" for ", 'red', '', "\033[0m");
    o("{$userBaseAction}", 'cyan', '', "\033[0m");
    o(" action.", 'red');
    exit(1);
}

try {
    call_user_func_array(
        [$actionClass, $classMethodToCall],
        array_slice($argv, 3)
    );
} catch (\Throwable $e) {
    if (strpos($e->getMessage(), 'Too few arguments') !== false) {
        o('Too few arguments.', 'red');
    } else {
        o($e->getMessage(), 'red');
    }

    exit(1);
}
